# Whitechain network
WC_RPC_URL=https://rpc.testnet.whitechain.io
WC_CHAIN_ID=1874

# Relayer EOA — funded from faucet.testnet.whitechain.io, pays gas + tops up wallets
RELAYER_PRIVATE_KEY=0x...

# 32-byte hex key for AES-GCM encryption of private keys + biometric templates
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WALLET_ENCRYPTION_KEY=

# Deployed contract addresses (from contracts/deployments/sepolia.json after forge deploy)
PWSR_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
BIOMETRIC_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_PROCESSOR_ADDRESS=0x0000000000000000000000000000000000000000

# Database (SQLite for dev, Postgres URL for prod)
DATABASE_URL=sqlite:///./facepay.db

# Face recognition cosine-distance cutoff (lower = stricter)
FACE_MATCH_THRESHOLD=0.35

# WBT topped up into each new custodial wallet by the relayer on enrollment
GAS_BUFFER_WBT=0.01

# CORS origin for the frontend
CORS_ORIGIN=http://localhost:3000
